---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
export async function getStaticPaths(){const posts=await getCollection('posts',({data})=>!data.draft);return posts.map(post=>({params:{id:post.id.replace(/\/index$/,'')},props:{post}}));}
const { post }=Astro.props;
const { Content }=await render(post);
---
<Post title={post.data.title} date={post.data.date} summary={post.data.summary}><Content/></Post>
